{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://cricketgpt.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "frontend/dist/$1" }
  ]
}
